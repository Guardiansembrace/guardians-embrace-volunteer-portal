# =============================================================================
# Guardian's Embrace - Volunteer Portal Frontend
# Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Dev Server Configuration
# -----------------------------------------------------------------------------
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# Preferred: manage protocol/host/port separately
VITE_API_PROTOCOL=http
VITE_API_HOST=localhost
VITE_API_PORT=8081

# Optional override: set this instead of the three vars above if you want to use
# a full backend base URL directly.
# VITE_API_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# Monitoring / Error Capture
# ---------------------------------------------------------------------------
VITE_MONITORING_ENABLED=true
VITE_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Google OAuth 2.0
# -----------------------------------------------------------------------------
# IMPORTANT: This must match the GOOGLE_CLIENT_ID in the backend .env
# Get this from Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
