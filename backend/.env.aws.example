# =============================================================================
# Guardian's Embrace - Volunteer Portal Backend
# AWS deployment environment variables
# =============================================================================
# Copy this file to .env.aws and fill in the values.
# Keep backend/.env for local development and use backend/.env.aws for Lambda.
# NEVER commit the real .env.aws file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
DEBUG=false
APP_NAME="Guardian's Embrace Volunteer Portal"
HOST=0.0.0.0
PORT=8081
MONITORING_ENABLED=true
FRONTEND_ERROR_INGEST_ENABLED=true
LOG_TO_FILE=false

# -----------------------------------------------------------------------------
# MongoDB Atlas
# -----------------------------------------------------------------------------
# Make sure MongoDB Atlas Network Access allows connections from AWS.
# For quick testing, teams often temporarily allow 0.0.0.0/0 and then tighten it later.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/guardians_portal?retryWrites=true&w=majority
MONGODB_DATABASE=guardians_portal
USE_MOCK_DB=false

# -----------------------------------------------------------------------------
# Google OAuth 2.0
# -----------------------------------------------------------------------------
# Use the same web client ID the frontend uses in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# JWT Token Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Admin Users
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin@yourdomain.org

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# Replace with your CloudFront URL or custom frontend domain.
ALLOWED_ORIGINS=["https://your-cloudfront-domain.cloudfront.net"]
FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net
FILE_DOWNLOAD_TOKEN_EXPIRE_MINUTES=5

# -----------------------------------------------------------------------------
# AWS S3 Storage
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_PUBLIC_ASSETS_BASE_URL=

# -----------------------------------------------------------------------------
# Weekly Submission Schedule
# -----------------------------------------------------------------------------
WEEKLY_UPDATE_START_DAY=friday
WEEKLY_UPDATE_END_DAY=sunday
TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# Google Drive Integration (optional)
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# -----------------------------------------------------------------------------
# SMTP Email
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Guardian's Embrace
