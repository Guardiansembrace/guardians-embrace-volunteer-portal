# =============================================================================
# Guardian's Embrace - Volunteer Portal Backend
# Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
DEBUG=true
APP_NAME="Guardian's Embrace Volunteer Portal"
HOST=0.0.0.0
PORT=8081
MONITORING_ENABLED=true
FRONTEND_ERROR_INGEST_ENABLED=true
LOG_TO_FILE=false

# -----------------------------------------------------------------------------
# MongoDB Atlas
# -----------------------------------------------------------------------------
# 1. Go to https://cloud.mongodb.com/
# 2. Create a free cluster (M0 tier)
# 3. Create a database user with read/write access
# 4. Get connection string and replace <username>, <password>, <cluster>
# 5. Whitelist your IP address in Network Access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xq4xd.mongodb.net/guardians_portal?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=guardians_portal

# -----------------------------------------------------------------------------
# Google OAuth 2.0
# -----------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable "Google+ API" or "People API"
# 4. Go to Credentials → Create OAuth 2.0 Client ID
# 5. Add authorized origins: http://localhost:5173, http://localhost:5174
# 6. Copy Client ID and Client Secret here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# JWT Token Configuration
# -----------------------------------------------------------------------------
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Admin Users
# -----------------------------------------------------------------------------
# Comma-separated list of emails that get admin role on first login
ADMIN_EMAILS=admin@yourdomain.org

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# JSON array of allowed frontend origins
# Add all ports your frontend might run on during development
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://localhost:3000"]

# Frontend URL — used in outgoing emails (invites, reminders)
# In production, set this to your actual frontend URL e.g. https://portal.guardiansembrace.org
FRONTEND_URL=http://localhost:5173
FILE_DOWNLOAD_TOKEN_EXPIRE_MINUTES=5

# ---------------------------------------------------------------------------
# AWS S3 Storage (Recommended for Lambda / Cloud Deployments)
# ---------------------------------------------------------------------------
# Leave blank in local development unless you want to use AWS directly.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional: if you later serve public assets from a dedicated S3/CloudFront URL,
# set it here. Otherwise the API serves banner images directly.
AWS_PUBLIC_ASSETS_BASE_URL=

# -----------------------------------------------------------------------------
# Weekly Submission Schedule
# -----------------------------------------------------------------------------
WEEKLY_UPDATE_START_DAY=friday
WEEKLY_UPDATE_END_DAY=sunday
TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# Google Drive Integration (File Uploads)
# -----------------------------------------------------------------------------
# To enable file uploads to Google Drive:
#
# 1. Go to Google Cloud Console → APIs & Services → Credentials
# 2. Create a Service Account
# 3. Download the JSON key file → save as backend/service-account.json
# 4. Create a Shared Drive in Google Workspace
# 5. Add the service account email as Content Manager on the Shared Drive
# 6. Get the Shared Drive ID from the URL (drive.google.com/drive/folders/XXXXX)
#
# GOOGLE_DRIVE_CREDENTIALS_JSON — optional: full JSON content as env var
# GOOGLE_DRIVE_SHARED_DRIVE_ID  — required: Shared Drive ID from the URL
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# -----------------------------------------------------------------------------
# SMTP Email (for Reminder Notifications)
# -----------------------------------------------------------------------------
# Optional — enables the "Send Reminders" feature for admins.
# For Gmail / Google Workspace, use an App Password:
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Guardian's Embrace

# -----------------------------------------------------------------------------
# EspoCRM Integration (Open Source CRM)
# -----------------------------------------------------------------------------
# EspoCRM should run as its own service/container. Create an EspoCRM API User
# with API Key authentication and least-privilege access to Contact, Account,
# Task, and Note records.
ESPOCRM_SITE_URL=https://crm.yourdomain.org
ESPOCRM_API_KEY=
ESPOCRM_TIMEOUT_SECONDS=10
